# ============================================
# Site Documentation Bot - Environment Config
# Copy this file to ".env" and fill in real values
# Only these 4 are required. Everything else the
# bot figures out automatically or uses a sane default for.
# For captcha, you have to do the captcha manually.
# ============================================

# The site you want documented
BASE_URL=https://www.your_site.com/

# The login page (leave blank if no login required)
LOGIN_URL=https://www.your_site.com/login

# Your login credentials
LOGIN_EMAIL=your_email@gmail.com
LOGIN_PASSWORD=your_password

# Optional: enables AI-written feature descriptions instead of raw
# extracted structure. Leave blank to skip and still get a usable doc.
ANTHROPIC_API_KEY=